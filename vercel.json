{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "docs",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- docs/ vercel.json",
  "headers": [
    {
      "source": "/demo/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
