<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for Asphalt Demo.

    Cleartext (http://) traffic is restricted to specific local/testing
    hosts so release builds can talk to a staging server over plain HTTP
    without opening cleartext to the entire internet.

    For production, replace these domains with your HTTPS backend and
    remove this file (the default policy blocks all cleartext).

    Hosts allowed for cleartext:
      10.0.2.2   — Android emulator alias for host-machine localhost
      localhost  — loopback for on-device testing

    <domain> matches hostnames, not IP ranges, so a LAN address such as
    192.168.1.42 cannot be allowed here generically. Debug builds override
    this file (src/debug/res/xml) to allow cleartext to any host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
