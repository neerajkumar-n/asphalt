<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network security configuration. Overrides
    src/main/res/xml/network_security_config.xml in debug builds.

    Android matches <domain> entries against hostnames, not IP ranges, so the
    main config cannot allow "any address on my Wi-Fi". Debug builds talk to a
    backend on the developer's LAN (e.g. http://192.168.1.42:8080), whose
    address differs on every network, so cleartext is allowed for all hosts
    here. Release builds keep the restrictive main config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
